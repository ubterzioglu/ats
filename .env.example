# Supabase (optional). Without these the app runs fully client-side and
# simply does not persist or share reports.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins allowed to embed the analyzer. Empty = no embedding.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
