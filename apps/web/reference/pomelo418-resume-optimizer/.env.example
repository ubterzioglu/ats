# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.

# Anthropic Claude API key — get one at https://console.anthropic.com
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google OAuth 2.0 Client ID — create one at https://console.cloud.google.com
# Enable the "Google Drive API" and set the authorised JS origin to http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
