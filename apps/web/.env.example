# Supabase (optional). Without these the app runs fully client-side and
# simply does not persist or share reports.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the deployment. Share links are built from it, and it backs
# metadataBase for Open Graph URLs. Falls back to the request host when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The coming-soon holding page is served at / by default. Set this to "false"
# to open the analyzer. Read at request time, so it needs a restart, not a rebuild.
NEXT_PUBLIC_COMING_SOON=
