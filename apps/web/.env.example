# Supabase. Without NEXT_PUBLIC_SUPABASE_URL the gate is disabled (local development).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the deployment. Share links are built from it, and it backs
# metadataBase for Open Graph URLs. Falls back to the request host when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel. Comma-separated list of admin email addresses.
ADMIN_EMAILS=

# Cron job secret for maintenance endpoints.
CRON_SECRET=

# Salt for hashing IP addresses for rate limiting.
CLIENT_HASH_SALT=

# Google Drive integration (optional). Without these, CV files are not backed up to Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Signup notification mail (optional). Without these, no mail is sent.
# Zoho: smtp.zoho.com (smtp.zoho.eu for EU accounts), port 465. With 2FA on,
# SMTP_PASS must be an app-specific password. SMTP_FROM must be the
# authenticated Zoho address or one of its aliases.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SIGNUP_NOTIFY_TO=
