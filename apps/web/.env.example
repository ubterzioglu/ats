# Supabase (optional). Without these the app runs fully client-side and
# simply does not persist or share reports.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the deployment. Share links are built from it, and it backs
# metadataBase for Open Graph URLs. Falls back to the request host when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel. Comma-separated list of admin email addresses.
ADMIN_EMAILS=

# Cron job secret for maintenance endpoints.
CRON_SECRET=

# Salt for hashing IP addresses for rate limiting.
CLIENT_HASH_SALT=

# Google Drive integration (optional). Without these, CV files are not backed up to Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=


